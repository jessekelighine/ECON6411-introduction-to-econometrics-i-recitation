%%% Color %%%
\usepackage{xcolor}
\definecolor{myred}{RGB}{229,0,0}
\definecolor{myblue}{RGB}{0,98,144}
\definecolor{myyellow}{RGB}{246,182,50}
\definecolor{mygreen}{RGB}{75,108,89}
\definecolor{mygray}{RGB}{100,100,100}
\newcommand{\red}[1]{\textcolor{myred}{#1}}
\newcommand{\blue}[1]{\textcolor{myblue}{#1}}
\newcommand{\yellow}[1]{\textcolor{myyellow}{#1}}
\newcommand{\green}[1]{\textcolor{mygreen}{#1}}
\newcommand{\gray}[1]{\textcolor{mygray}{#1}}
%-----------------------------------------------------------------------------%
%%% Hyper Reference %%%
\PassOptionsToPackage{hyphens}{url}
\usepackage{hyperref}
\hypersetup{hidelinks,colorlinks=true,
linkcolor=myred,
urlcolor=myblue,
citecolor=myblue}
%-----------------------------------------------------------------------------%
%%% Date Time %%%
\usepackage{datetime}
\newtimeformat{mytime}%
{\twodigit{\THEHOUR}:\twodigit{\THEMINUTE}} % \THESECOND
\settimeformat{mytime}%
\newdateformat{mydate}
{\THEYEAR-\twodigit{\THEMONTH}-\twodigit{\THEDAY}}
\setdefaultdate{\mydate}
%-----------------------------------------------------------------------------%
%%% Minimal Title %%%
\makeatletter\def\@maketitle{%
\noindent{\raggedright{\bfseries\@title}}%
\hfill\texttt{\@date}\\%
\raggedleft\ttfamily\@author%
\par\vskip1em}\makeatother
