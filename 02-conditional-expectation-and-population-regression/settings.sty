%%% Math %%%
\usepackage{amsmath,mathtools,amssymb,mathrsfs}
% \usepackage{centernot}
% \usepackage{accents}
% \usepackage[makeroom]{cancel}
\newcommand{\raum}[1][=]{\mathrel{\phantom{#1}}}
\newcommand{\one}{\mathbf{1}}
\newcommand{\reals}{\mathbb{R}}
\newcommand{\naturals}{\mathbb{N}}
\newcommand{\complex}{\mathbb{C}}
\newcommand{\yy}{\mathbf y}
\newcommand{\XX}{\mathbf X}
\newcommand{\WW}{\mathbf W}
\newcommand{\indep}{\mathrel{\perp\hspace{-0.6em}\perp}}
\newcommand{\Tsymb}{\prime}
\newcommand{\T}{^{\Tsymb}}
\newcommand{\inv}{^{-1}}
\newcommand{\invT}{^{\Tsymb-1}}
\DeclareMathOperator{\diag}{diag}
\DeclareMathOperator{\range}{Range}
\DeclareMathOperator{\logit}{logit}
\DeclareMathOperator{\logistic}{logistic}
\DeclareMathOperator{\vect}{vec}
\DeclareMathOperator{\normaldistribution}{\mathcal{N}}
%-----------------------------------------------------------------------------%
%%% Probability %%%
\DeclareMathOperator{\E}{\mathbb{E}}
\DeclareMathOperator{\var}{\text{\textrm{\upshape\textbf{Var}}}}
\DeclareMathOperator{\cov}{\text{\textrm{\upshape\textbf{Cov}}}}
\newcommand{\iidto}{\overset{\text{\tiny iid}}{\sim}}
\newcommand{\asto}{\overset{as}{\longrightarrow}}
\newcommand{\pto}{\overset{p}{\longrightarrow}}
\newcommand{\dto}[1][]{\overset{#1}{\leadsto}}
\newcommand{\given}[1][]{\mathpunct{}#1|\mathpunct{}}
%-----------------------------------------------------------------------------%
%%% Calculus %%%
\newcommand{\diff}[2][\mathrm{d}]{\mathop{}\!{#1}{#2}}
\newcommand{\Deriv}[3][\mathrm{d}]{
\mathchoice%
{\frac{\diff[#1]{}}{\diff[#1]{#2}}{#3}}% display style
{\partial_{#2}{#3}}% text style
{#1 #3 / #1 #2}% script style
{#1 #3 / #1 #2}% scriptscript style
}
%-----------------------------------------------------------------------------%
%%% Math Notes %%%
\usepackage{amsthm,thmtools}
\declaretheoremstyle[
spaceabove=\topsep,
spacebelow=\topsep,
headfont=\normalfont\bfseries,
notefont=\mdseries,
notebraces={(}{)},
bodyfont=\normalfont,
postheadspace=1em,
% qed={}
]{my}
\declaretheorem[style=my,name=Definition]{definition}
\declaretheorem[style=my,name=Theorem]{theorem}
\declaretheorem[style=my,name=Corollary]{corollary}
\declaretheorem[style=my,name=Lemma]{lemma}
\declaretheorem[style=my,name=Proposition]{proposition}
\declaretheorem[style=my,name=Remark]{remark}
\declaretheorem[style=my,name=Example]{example}
\declaretheorem[style=my,name=Assumption]{assumption}
\renewcommand{\qedsymbol}{\blue{$\blacksquare$}}
%-----------------------------------------------------------------------------%
%%% TikZ Color Box %%%
\usepackage[breakable]{tcolorbox}
\tcbuselibrary{theorems,skins}
\makeatletter
\tcbset{mycolorbox/.style={
breakable,enhanced,sharp corners,frame hidden,boxrule=0sp,
left=8pt,right=4pt,top=4pt,bottom=4pt,
colback=#1!5,borderline west={3pt}{0pt}{#1}}}
\tcolorboxenvironment{definition}{mycolorbox={myred}}
\tcolorboxenvironment{assumption}{mycolorbox={black}}
\tcolorboxenvironment{theorem}{mycolorbox={myblue}}
\tcolorboxenvironment{proposition}{mycolorbox={myblue}}
\tcolorboxenvironment{corollary}{mycolorbox={myblue}}
\tcolorboxenvironment{lemma}{mycolorbox={myblue}}
\tcolorboxenvironment{example}{mycolorbox={black}}
\makeatother
